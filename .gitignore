# Generated data — regenerable from gen_parametric_dataset.py with the recorded seed.
# The manifests ARE tracked: they carry the splits, the rejection tally and the
# per-sample metadata that cannot be recovered from the .npy files.
data/**/*.npy
data/_probe*/
data/_SUPERSEDED*/
data/*.npz
data/*.pth
# ...but never the manifests.
!data/**/manifest.json
!data/**/_partial.json

# Model checkpoints
*.pth
!data/_RETRACTED/*.pth

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Large figure PDFs are regenerable; PNGs are tracked for review convenience.
figures/*.pdf

# Packaging artefacts
*.zip

# OS
Thumbs.db
.DS_Store

# Extracted journal figures used for digitisation: copyrighted, kept locally only.
refs/*.png
refs/*.docx

# autorun runtime state -- a lock and a heartbeat, meaningless outside this machine
autorun.lock
autorun_state.json
data/p2/
tools/
paper/*.aux
paper/*.log
paper/*.bbl
paper/*.blg
paper/*.out
paper/manuscript.pdf

# Personal / not for the public repository
USER_ACTIONS.md
outreach/
refs/*.pdf
# scratch
results/tmp*.tmp
